# Database Configuration
MONGODB_URI=mongodb://localhost:27017/contact-management
# or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/contact-management

# LLM Provider Configuration
# Choose one of: openai, gemini, ollama

# Option 1: OpenAI (ChatGPT)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk_your_openai_key_here
# LLM_MODEL=gpt-3.5-turbo

# Option 2: Google Gemini
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-pro

# Option 3: Ollama (Local, Free)
# LLM_PROVIDER=ollama
# LLM_ENDPOINT=http://localhost:11434
# LLM_MODEL=mistral
# Note: Install Ollama from https://ollama.ai and run: ollama run mistral

# Server Configuration
PORT=5000
NODE_ENV=development
